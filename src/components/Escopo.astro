---
import CheckIcon from '@/components/CheckIcon.astro'
import { prices, whatsappLink } from '@/lib/site-config'

const recursosComuns = ['Botão de WhatsApp', 'Formulário de contato', 'SEO técnico básico']
const pacotes = [
  {
    nome: 'Site Essencial',
    preco: prices.essential,
    itens: ['Até 3 páginas', 'Design responsivo com layout personalizado simples', ...recursosComuns, 'Uma rodada de ajustes'],
    botao: 'Quero o Essencial',
    interesse: 'essential',
    destaque: false,
  },
  {
    nome: 'Site Profissional',
    preco: prices.professional,
    itens: [
      'Até 5 páginas',
      'Design responsivo e personalizado',
      'Estrutura de navegação organizada',
      ...recursosComuns,
      'Apoio na organização do conteúdo fornecido pelo cliente',
      'Até duas rodadas de ajustes',
    ],
    botao: 'Quero o Profissional',
    interesse: 'professional',
    destaque: true,
  },
] as const

const extras = [
  { emoji: '📝', titulo: 'Blog pronto pra publicar', preco: '+ R$ 497' },
  { emoji: '🛒', titulo: 'Loja virtual, login, sistema, 10+ páginas', preco: '+ R$ 997' },
  { emoji: '🧩', titulo: 'SaaS, integrações e projetos maiores', preco: 'A consultar no WhatsApp' },
]
---

<section id="escopo" class="py-20 md:py-28" aria-labelledby="escopo-heading">
  <div class="mx-auto max-w-[1200px] px-6">
    <h2 id="escopo-heading" class="reveal text-2xl md:text-3xl font-bold tracking-tight">
      Seu site profissional, do seu jeito.
    </h2>
    <p class="reveal mt-3 text-sm text-muted-foreground">
      Escolha a solução ideal para apresentar seu negócio com profissionalismo.
    </p>

    <div class="reveal-stagger mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {pacotes.map((pacote) => (
        <article class:list={['reveal flex flex-col rounded-lg border bg-card p-6 md:p-8', pacote.destaque ? 'border-highlight/30' : 'border-border/50']}>
          <h3 class="text-lg font-semibold">{pacote.nome}</h3>
          <p class="mt-4 text-xs text-muted-foreground">A partir de</p>
          <p class="mt-1 text-3xl font-bold tracking-tight text-highlight md:text-4xl">{pacote.preco}</p>
          <ul class="mt-6 space-y-3">
            {pacote.itens.map((item) => (
              <li class="flex items-start gap-2 text-sm text-muted-foreground"><CheckIcon />{item}</li>
            ))}
          </ul>
          <div class="mt-auto pt-8">
            <a href={whatsappLink(pacote.interesse)} class="cta-ring flex min-h-[44px] w-full items-center justify-center rounded-md bg-highlight px-4 py-3 text-center text-sm font-semibold text-highlight-foreground hover:opacity-90">
              {pacote.botao}
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="reveal mt-6 max-w-3xl text-xs leading-relaxed text-muted-foreground">
      Os preços são iniciais e dependem do escopo. O pagamento é feito em duas etapas, metade no início e metade na entrega.
      Domínio, hospedagem, manutenção recorrente e serviços de terceiros podem ser cobrados à parte.
    </p>

    <div class="reveal mt-12 border-t border-border/50 pt-8">
      <h3 class="text-sm font-semibold">Opcionais</h3>
      <ul class="mt-4 divide-y divide-border/50">
        {extras.map((extra) => (
          <li class="flex flex-col gap-1 py-3 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <span class="text-muted-foreground"><span aria-hidden="true">{extra.emoji}</span> {extra.titulo}</span>
            <span class="font-semibold">{extra.preco}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
