<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-border/50 bg-background/95 backdrop-blur-md p-3 md:hidden translate-y-full transition-transform duration-500"
>
  <a
    href="#contato"
    class="flex w-full items-center justify-center rounded-md bg-highlight text-highlight-foreground font-semibold text-sm py-3"
  >
    Quero meu site 🚀
  </a>
</div>

<script>
  const hero = document.querySelector<HTMLElement>('#hero')
  const bar = document.querySelector<HTMLElement>('#sticky-cta')

  if (hero && bar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bar.classList.add('translate-y-full')
          } else {
            bar.classList.remove('translate-y-full')
          }
        })
      },
      { threshold: 0 }
    )

    observer.observe(hero)
  }
</script>
