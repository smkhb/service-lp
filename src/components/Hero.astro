---
import { whatsappLink } from '@/lib/site-config'

const palavras = ['Sites', 'e', 'soluções', 'digitais']
const palavrasDestaque = ['para', 'pequenos', 'negócios']
const exemplos = [
  { posicao: 'left', tipo: 'chat', rotulo: 'Atendimento inteligente' },
  { posicao: 'right', tipo: 'automation', rotulo: 'Automação' },
  { posicao: 'center', tipo: 'site', rotulo: 'Site institucional' },
]
---

<section
  id="hero"
  class="relative overflow-hidden flex flex-col items-center justify-center min-h-[calc(100svh-3.5rem)] md:min-h-[44rem] pt-20 pb-16"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0 bg-dot-grid pointer-events-none" aria-hidden="true"></div>
  <div class="relative mx-auto w-full max-w-[1200px] px-6 text-center">
    <span
      class="mx-auto inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-xs text-muted-foreground"
    >
      💬 Conversa inicial sem compromisso
    </span>
    <h1
      id="hero-heading"
      class="mx-auto mt-6 max-w-[56rem] text-[2rem] sm:text-5xl md:text-6xl [text-wrap:balance] font-bold leading-[1.05] tracking-[-0.04em]"
    >
      {
        palavras.map((palavra, i) => (
          <span class="hero-word" style={`--d:${i * 90}ms`}>
            {palavra}{' '}
          </span>
        ))
      }
      <span class="md:block">
        {
          palavrasDestaque.map((palavra, i) => (
            <span
              class="hero-word text-muted-foreground"
              style={`--d:${(palavras.length + i) * 90}ms`}
            >
              {palavra}{' '}
            </span>
          ))
        }
      </span>
    </h1>
    <p class="reveal mx-auto mt-6 max-w-xl text-sm sm:text-base leading-relaxed text-muted-foreground">
      Crio sites profissionais e landing pages para apresentar seu negócio e conquistar clientes.
      Também desenvolvo chatbots, automatizo tarefas e melhoro sistemas que você já usa.
    </p>
    <div class="reveal mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={whatsappLink('contact')}
        class="cta-ring inline-flex h-[52px] items-center justify-center rounded-lg px-6 text-sm sm:text-base font-semibold transition-transform bg-highlight text-highlight-foreground hover:scale-[1.03]"
      >
        Conversar sobre meu projeto
      </a>
      <a
        href="#servicos"
        class="inline-flex h-[52px] items-center justify-center rounded-lg px-6 text-sm sm:text-base font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
      >
        Explorar serviços
      </a>
    </div>
    <div
      class="hero-previews relative mx-auto mt-16 md:mt-20 h-[15rem] sm:h-[18rem] md:h-[24rem] w-full max-w-[82rem]"
      aria-hidden="true"
    >
      {
        exemplos.map((exemplo) => (
          <div
            class={`hero-preview hero-preview--${exemplo.posicao} absolute left-1/2 top-0 aspect-[4/3] w-[min(18rem,68vw)] md:w-[22rem] lg:w-[26rem] overflow-hidden rounded-[20px] border-[6px] border-muted bg-card shadow-[0_1.25rem_3rem_rgba(0,0,0,0.45),0_0.25rem_0.75rem_rgba(0,0,0,0.25)]`}
          >
            {exemplo.tipo === 'chat' && (
              <div class="flex h-full flex-col bg-[#121c19] p-3 text-left text-[#e2eee7] sm:p-5">
                <p class="border-b border-white/10 pb-2 text-[10px] font-semibold text-[#9ee5bb]">{exemplo.rotulo}</p>
                <div class="mt-3 space-y-2 text-[10px] leading-snug sm:text-xs">
                  <p class="w-fit rounded-lg rounded-tl-sm bg-white/10 px-2 py-1.5">Olá! Como posso ajudar?</p>
                  <p class="ml-auto w-fit rounded-lg rounded-tr-sm bg-[#9ee5bb] px-2 py-1.5 text-[#121c19]">Quero agendar um horário.</p>
                  <p class="w-fit rounded-lg rounded-tl-sm bg-white/10 px-2 py-1.5">Claro! Qual dia funciona?</p>
                </div>
              </div>
            )}
            {exemplo.tipo === 'automation' && (
              <div class="flex h-full flex-col items-end bg-[#211e2b] p-3 text-right text-[#eee9fa] sm:p-5">
                <p class="w-full border-b border-white/10 pb-2 text-[10px] font-semibold text-[#d5c5fb]">{exemplo.rotulo}</p>
                <ol class="mt-3 grid gap-1.5 border-r border-[#d5c5fb]/40 pr-2 text-[10px] leading-snug sm:text-xs">
                  <li class="rounded-md border border-white/10 bg-white/5 px-2 py-1.5">Pedido recebido</li>
                  <li class="rounded-md border border-white/10 bg-white/5 px-2 py-1.5">Registro atualizado</li>
                  <li class="rounded-md bg-[#d5c5fb] px-2 py-1.5 text-[#211e2b]">Equipe avisada</li>
                </ol>
              </div>
            )}
            {exemplo.tipo === 'site' && (
              <div class="flex h-full flex-col bg-background text-left text-foreground">
                <div class="flex items-center justify-between gap-2 border-b border-white/10 px-3 py-2 sm:px-5 sm:py-3">
                  <p class="text-[10px] font-semibold text-highlight">{exemplo.rotulo}</p>
                  <span class="hidden text-[10px] text-muted-foreground sm:inline">Sobre · Serviços · Contato</span>
                </div>
                <div class="flex flex-1 flex-col justify-center bg-dot-grid px-3 sm:px-5">
                  <p class="max-w-[17rem] text-sm font-semibold leading-tight sm:text-xl">Seu negócio na internet</p>
                  <p class="mt-1 text-[10px] text-muted-foreground sm:text-xs">Apresente seus serviços e facilite o contato.</p>
                  <span class="mt-2 w-fit rounded bg-highlight px-2 py-1 text-[10px] font-semibold text-highlight-foreground sm:mt-4">Conheça os serviços</span>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
    <div class="-mt-4 flex justify-center md:hidden" role="group" aria-label="Prévias de soluções">
      {exemplos.map((exemplo, i) => (
        <button
          type="button"
          data-hero-dot
          class="grid h-11 w-11 place-items-center rounded-md opacity-30 transition-opacity"
          aria-label={`Ver prévia de ${exemplo.rotulo}`}
          aria-pressed={i === 2 ? 'true' : 'false'}
        >
          <span class="h-2 w-2 rounded-full bg-highlight"></span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-preview {
    opacity: 0;
    transform: translate(var(--tx), var(--ty)) rotate(var(--r)) scale(var(--s));
    animation: hero-previews-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.95s forwards;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-previews {
    touch-action: pan-y;
  }

  @media (hover: hover) and (min-width: 768px) {
    .hero-preview:hover {
      transform: translate(var(--tx), calc(var(--ty) - 1.5rem)) rotate(0deg) scale(1);
      z-index: 10;
    }
  }

  .hero-preview--center {
    --tx: -50%;
    --ty: -3.5rem;
    --r: 0deg;
    --s: 1;
    z-index: 4;
  }

  .hero-preview--left {
    --tx: calc(-50% - 18vw);
    --ty: -2rem;
    --r: -3deg;
    --s: 0.92;
    z-index: 1;
  }

  .hero-preview--right {
    --tx: calc(-50% + 18vw);
    --ty: -2rem;
    --r: 3deg;
    --s: 0.92;
    z-index: 2;
  }

  @keyframes hero-previews-rise {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 767px) {
    .hero-preview--center {
      --ty: -1rem;
    }

    .hero-preview--left {
      --tx: calc(-50% - 9vw);
      --ty: 0;
      --s: 0.85;
    }

    .hero-preview--right {
      --tx: calc(-50% + 9vw);
      --ty: 0;
      --s: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-preview {
      animation: none;
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  const POS = ['hero-preview--left', 'hero-preview--right', 'hero-preview--center']
  const BASE = ['hero-preview--left', 'hero-preview--right', 'hero-preview--center']
  const wrap = document.querySelector<HTMLElement>('.hero-previews')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.hero-preview'))
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'))
  const mobile = window.matchMedia('(max-width: 767px)')
  let current = 2
  let startX = 0
  let startY = 0
  let tracking = false

  const place = (card: HTMLElement, pos: string) => {
    card.classList.remove(...POS)
    card.classList.add(pos)
  }

  const apply = () => {
    cards.forEach((card, i) => {
      if (!mobile.matches) {
        place(card, BASE[i])
        return
      }
      const offset = (i - current + 3) % 3
      place(card, offset === 0 ? 'hero-preview--center' : offset === 1 ? 'hero-preview--left' : 'hero-preview--right')
    })
    dots.forEach((dot, i) => {
      dot.setAttribute('aria-pressed', String(i === current))
      dot.classList.toggle('opacity-100', i === current)
      dot.classList.toggle('opacity-30', i !== current)
    })
  }

  const show = (index: number) => {
    current = index
    apply()
  }

  wrap?.addEventListener('pointerdown', (e) => {
    if (!mobile.matches || e.pointerType !== 'touch') return
    startX = e.clientX
    startY = e.clientY
    tracking = true
  })

  wrap?.addEventListener('pointercancel', () => {
    tracking = false
  })

  wrap?.addEventListener('pointerup', (e) => {
    if (!tracking) return
    tracking = false
    const dx = e.clientX - startX
    const dy = e.clientY - startY
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
      show(dx < 0 ? (current + 2) % 3 : (current + 1) % 3)
      return
    }
    const card = (e.target as HTMLElement).closest<HTMLElement>('.hero-preview')
    const index = card ? cards.indexOf(card) : -1
    if (index !== -1 && index !== current) show(index)
  })

  wrap?.addEventListener('click', (e) => {
    if (!mobile.matches || (e as PointerEvent).pointerType === 'touch') return
    const card = (e.target as HTMLElement).closest<HTMLElement>('.hero-preview')
    const index = card ? cards.indexOf(card) : -1
    if (index !== -1 && index !== current) show(index)
  })

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => show(i))
  })

  mobile.addEventListener('change', apply)
  apply()
</script>
