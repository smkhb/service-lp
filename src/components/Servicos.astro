---
import CheckIcon from '@/components/CheckIcon.astro'
import { prices, whatsappLink } from '@/lib/site-config'

const principais = [
  {
    emoji: '🏢',
    titulo: 'Sites Institucionais',
    descricao: 'Sites profissionais para apresentar seu negócio, seus serviços e seus canais de contato.',
    preco: `A partir de ${prices.essential}`,
    itens: ['Design responsivo e personalizado', 'Pacotes de até 3 ou 5 páginas', 'WhatsApp, formulário e SEO técnico básico'],
    botao: 'Quero meu site',
    interesse: 'site',
  },
  {
    emoji: '🚀',
    titulo: 'Landing Pages',
    descricao: 'Páginas para apresentar um produto, serviço ou campanha e captar potenciais clientes.',
    preco: `A partir de ${prices.landing}`,
    itens: [
      'Página única responsiva com layout personalizado simples',
      'Conteúdo fornecido pelo cliente',
      'WhatsApp ou formulário básico',
      'SEO técnico básico e uma rodada de ajustes',
    ],
    nota: 'Redação completa, integrações avançadas e animações elaboradas são orçadas à parte.',
    botao: 'Quero minha landing page',
    interesse: 'landing',
  },
] as const

const complementares = [
  {
    emoji: '💬',
    titulo: 'Chatbots & Atendimento Inteligente',
    descricao: 'Responda dúvidas, organize contatos e qualifique clientes com opção de encaminhar a conversa para atendimento humano.',
    botao: 'Automatizar meu atendimento',
    interesse: 'chatbot',
  },
  {
    emoji: '⚙️',
    titulo: 'Automações & Integrações com IA',
    descricao: 'Conecte ferramentas e sistemas para automatizar tarefas repetitivas e organizar informações.',
    botao: 'Quero automatizar',
    interesse: 'automation',
  },
  {
    emoji: '🛠️',
    titulo: 'Manutenção e Consultoria',
    descricao: 'Corrija problemas, melhore projetos existentes e tenha orientação técnica para decidir os próximos passos.',
    botao: 'Preciso de suporte',
    interesse: 'maintenance',
  },
] as const

const grupos = [
  { servicos: principais, grid: 'md:grid-cols-2', card: 'p-6 md:p-8' },
  { servicos: complementares, grid: 'lg:grid-cols-3', card: 'p-6' },
]
---

<section id="servicos" class="py-20 md:py-28 bg-card" aria-labelledby="servicos-heading">
  <div class="mx-auto max-w-[1200px] px-6">
    <h2 id="servicos-heading" class="reveal text-2xl md:text-3xl font-bold tracking-tight">O que eu faço</h2>
    <p class="reveal mt-3 text-sm text-muted-foreground max-w-lg">
      Do seu primeiro site à automação de tarefas do dia a dia.
    </p>
    {grupos.map((grupo, index) => (
      <div class:list={['reveal-stagger grid grid-cols-1 gap-6', grupo.grid, index === 0 ? 'mt-12' : 'mt-6']}>
        {grupo.servicos.map((servico) => (
          <article class:list={['reveal flex flex-col rounded-lg border border-border/50 bg-background hover:border-border transition-colors', grupo.card]}>
            <div class="text-3xl mb-4" aria-hidden="true">{servico.emoji}</div>
            <h3 class="text-lg font-semibold mb-3">{servico.titulo}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{servico.descricao}</p>
            <p class="mt-4 text-sm font-semibold text-highlight">{'preco' in servico ? servico.preco : 'Sob orçamento'}</p>
            {'itens' in servico && (
              <ul class="mt-4 space-y-2">
                {servico.itens.map((item) => (
                  <li class="flex items-start gap-2 text-xs text-muted-foreground"><CheckIcon />{item}</li>
                ))}
              </ul>
            )}
            {'nota' in servico && <p class="mt-4 text-xs leading-relaxed text-muted-foreground">{servico.nota}</p>}
            <div class="mt-auto pt-6">
              <a href={whatsappLink(servico.interesse)} class="cta-ring inline-flex min-h-[44px] items-center rounded-md bg-highlight px-4 py-2 text-xs font-semibold text-highlight-foreground hover:opacity-90">
                {servico.botao}
              </a>
            </div>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>
